{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/finalcountdown",
      "destination": "/"
    },
    {
      "source": "/finalcountdown/",
      "destination": "/"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://the-bourbon-cup.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://the-bourbon-cup.firebaseapp.com/__/firebase/:path*"
    }
  ]
}
