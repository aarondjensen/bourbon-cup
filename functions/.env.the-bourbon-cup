# ── Apple token revocation — the-bourbon-cup ────────────────────────
# Read by `revokeAppleToken` in index.js. See .env.example for what each value
# is and where it comes from; this is the filled-in copy the Firebase CLI
# uploads at deploy time.
#
# NONE OF THIS IS SECRET, which is why it is committed rather than sitting in
# a gitignored .env on one laptop: a key id travels in the JWT `kid` header, a
# team id is already in App.xcodeproj/project.pbxproj, and a bundle id is
# printed in the App Store. The one real secret is the .p8 itself, which goes
# to Google's secret manager and never here:
#
#   firebase functions:secrets:set APPLE_PRIVATE_KEY --data-file C:\dev\keys\AuthKey_6RF36PB9N8.p8

# The replacement key, created 10 Sep 2026 and named in the portal alongside
# one Sign in with Apple key per project (WBC, MNQ, SFGL) plus 7UA9A9SR3K
# "App APNs", which is the push key and is NOT interchangeable with these.
#
# It replaced 9K7J7J2VGT, which was NOT the wrong key — that one was "Bourbon
# Cup Apple Sign In" with Sign in with Apple as its only service, and it was
# revoked because its private key was pasted out of a terminal.
# `functions:secrets:access` PRINTS key material; `functions:secrets:describe`
# reports the versions and their state and never shows it. Destroying a Secret
# Manager version does not un-issue a key — only revoking it at Apple does,
# which is what happened here.
APPLE_KEY_ID=6RF36PB9N8
# ── THE SAME KEY IS CONFIGURED IN A SECOND PLACE ──
# Firebase Console → Authentication → Sign-in method → Apple → OAuth code flow
# configuration holds the team id, the Key Id and the private key too, and that
# is the copy Firebase's own revokeAccessToken uses for the WEB path. Changing
# the key here and not there leaves Firebase holding a dead credential on a
# live sign-in path, with nothing on screen to say so. See CLAUDE.md for the
# rotation order.
# VERIFIED 10 Sep 2026: apple-key-check returned invalid_grant for this key
# against team 7RRL56R755 and client com.thebourboncup.app — Apple accepted the
# credentials and refused only the probe's throwaway token. That is the NATIVE
# path, which had never once run before this. The web path is unverified until
# APPLE_CLIENT_ID below is filled in.

APPLE_TEAM_ID=7RRL56R755

# The Services ID for the WEB sign-in flow. Read off Firebase Console →
# Authentication → Sign-in method → Apple, which is the better source than
# Apple's own Identifiers list: this account holds one Services ID per project,
# and the console shows the one the web flow ACTUALLY uses. Its authorization
# callback there is https://the-bourbon-cup.firebaseapp.com/__/auth/handler.
#
# Not the same thing as the App ID below. A code from the web flow is bound to
# this; a code from the native sheet is bound to the bundle id, and sending the
# wrong one gets `invalid_client` — see the note at the top.
APPLE_CLIENT_ID=com.thebourboncup.web

# The iOS bundle id, used for a code from the native Apple sheet.
APPLE_BUNDLE_ID=com.thebourboncup.app
