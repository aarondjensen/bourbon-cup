# ── Apple token revocation ──────────────────────────────────────────
# Read by `revokeAppleToken` in index.js, which tells Apple to forget an
# account the user has just deleted (App Store guideline 5.1.1(v)). Without
# these the function throws `failed-precondition`, the client logs it, and the
# deletion proceeds — which is exactly where the app was before it existed.
#
# ── Copy this to a file the CLI will actually upload ──
# Firebase reads `.env`, `.env.<project-id>` and `.env.local` out of THIS
# directory at deploy time and turns them into the function's environment.
#
#   cp functions/.env.example functions/.env.the-bourbon-cup
#
# That name rather than `.env`, deliberately: a bare `functions/.env` is
# gitignored, so it lives on one laptop and a deploy from any other machine
# silently loses these. NONE OF THE FOUR BELOW IS A SECRET — a team id, a key
# id, a Services ID and a bundle id are all public identifiers, and the bundle
# id is printed in the App Store — so the project-suffixed file is committed
# and every machine can deploy.
#
# The one real secret is the .p8, which is NOT here and never should be. It
# goes to Google's secret manager, from the file Apple gave you:
#
#   firebase functions:secrets:set APPLE_PRIVATE_KEY --data-file C:\dev\keys\AuthKey_<KEY_ID>.p8
#
# (`--data-file` rather than pasting it: the key is multi-line PEM and the
# interactive prompt takes one line. `--data-file -` reads stdin if you would
# rather pipe it.)

# Check a secret exists with `functions:secrets:describe`, never
# `functions:secrets:access` — access PRINTS the key, and a key that reaches a
# terminal has reached scrollback.

# The 10-character id of that same .p8 — it is in the filename Apple gives you,
# AuthKey_<APPLE_KEY_ID>.p8, and on the key's page in the developer portal.
APPLE_KEY_ID=

# Apple Developer team id. Membership details, top right of the portal.
APPLE_TEAM_ID=

# The Services ID used by the WEB sign-in flow — the same identifier that lists
# https://the-bourbon-cup.firebaseapp.com/__/auth/handler as a return URL.
APPLE_CLIENT_ID=

# The iOS bundle id. Defaults to com.thebourboncup.app if unset, so this line
# only matters if that ever changes.
#
# WHY BOTH: an Apple authorization code is bound to the client that obtained
# it. A code from the native sheet belongs to the bundle id, one from the web
# flow to the Services ID, and sending the wrong one gets `invalid_client`
# back — which reads exactly like a bad key and is not. The caller says which
# shape it holds and the function picks.
APPLE_BUNDLE_ID=com.thebourboncup.app
