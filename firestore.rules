rules_version = '2';

// ══════════════════════════════════════════════════════════════════
//  Firestore security rules — The Bourbon Cup
// ══════════════════════════════════════════════════════════════════
//
// ── Read this before changing anything ────────────────────────────
// Two gates, and only the second one matters.
//
// People sign in with Google or Apple (src/lib/auth.js), which proves who
// they are and nothing else — anybody can make a Google account, and the
// app's Firebase config ships in the bundle by design, so "signed in" on
// its own would let any stranger who viewed source rewrite the tournament.
//
// So writing requires MEMBERSHIP: a bc_accounts/{uid} document, which an
// account can only create by presenting the tournament password. The
// password lives in bc_secrets/access, which only a director may read; the
// rules compare against it with `get()`, which is not subject to read
// rules, so the check works the same for everybody else.
// That is what makes it a lock rather than a doorman — it holds against
// someone reading the bundle, disabling the JavaScript, or skipping the
// app entirely and talking to Firestore with the public config.
//
// Reads stay open, deliberately: the leaderboard is meant to be glanceable
// by a spouse on the couch with a link, and the push service worker has no
// user to sign in as. If that ever needs to change, `isOpen()` is the one
// place to change it.
//
// Membership is not the last word: what Admin owns — the roster, rounds,
// matches, courses, groups, tee sheets, settings, editions and the
// password — requires DIRECTOR on top of it, which is a flag no client can
// set (see isDirector below). Members write the things players actually do
// from a tee box: scores, skins, CTPs, card signatures, the round lock,
// their own push token, and the one narrow update that claims their own
// name off the roster.
//
// Within each half there is no per-document ownership, deliberately.
// Scoring is communal — one phone posts for a group of four, the director
// fixes anybody's card — so "only your own rows" would break the actual
// workflow before it stopped anybody. The round gate, the finalize lock
// and the card signatures remain the client-side guards on top.
//
// ── Deploying this ────────────────────────────────────────────────
// Rules are deployed by hand and the app is not. Deploy these only once
// the matching build is live and everyone's phone has loaded it (a
// pull-to-refresh will do it). Deploy them first and any phone on an
// older bundle — including one signed in but with no membership document
// yet — silently fails every write it attempts: scores typed on the tee
// that never arrive.
//
// ── Locking somebody out ──────────────────────────────────────────
// Delete their bc_accounts document in the Firebase console. Nothing in
// the app can do it (update and delete are denied to every client), which
// is deliberate. Rotating the password afterwards does NOT evict anybody
// already through the door — existing memberships are never re-checked
// against it.
//
// ── Making somebody a director ────────────────────────────────────
// A director does it from the app: Admin → Players → the crown in the
// player modal, which writes `is_director` on that person's bc_accounts
// document. The app reads the same flag to decide whether to show the
// Admin tab, so what is on screen is what these rules will honour.
//
// Nobody can set it on themselves — not at create time, not after — so
// knowing the password never promotes anybody, and a director cannot
// demote themselves either, which means the set can never be emptied from
// inside the app.
//
// THE FIRST ONE HAS TO COME FROM THIS CONSOLE, because the rule requires a
// director to already exist: on their bc_accounts/{uid} document, add
// `is_director` (boolean) = true. That is also the way back if the set is
// ever emptied, and the way somebody steps down.
//
// Consequence worth knowing before publishing: until one membership
// document carries the flag, nobody can edit the tournament at all. Set it
// before these rules land, not after.
//
// The crown drawn in the roster LIST is read from these same membership
// documents. The `isDirector` field on bc_players is vestigial — nothing
// reads it. Rules never could: finding the roster row whose auth_uid is
// yours would need a query, and rules only fetch paths they can construct.
//
// ── What this replaces ────────────────────────────────────────────
// Until this file, the deployed rules were a single blanket grant:
//
//   match /{document=**} { allow read, write: if true; }
//
// So the enumeration below IS the change. The list was taken from the
// collections the client actually touches (`db.subscribe` / `db.get` /
// `db.upsert` / `db.delete` in src/firebase.js, which is the only
// Firestore entry point in the repo — pipeline/ and api/ never reach
// Firestore), so anything newly denied is by construction something no
// code path here reads or writes. Data in such a collection is untouched,
// just unreachable until a line is added.
//
// Deploy with:  firebase deploy --only firestore:rules
//
// There are tests, and this file is the reason to run them — see
// firestore.rules.test.mjs for the one-liner. They cover the password
// path specifically: wrong code refused, code unreadable, non-member
// refused, and nobody minting a membership for somebody else's uid.

service cloud.firestore {
  match /databases/{database}/documents {

    // Reading is open to anyone with the app — a shared leaderboard link,
    // the push service worker, a phone that has not signed in yet.
    function isOpen() {
      return true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ── Membership ────────────────────────────────────────────────
    // Writing needs more than an account: it needs a membership document,
    // issued only to someone who presented the tournament password (see
    // bc_accounts below). Signing in is free — anybody can make a Google
    // account — so this is the predicate that actually decides who can
    // change the tournament, and it holds against someone talking to
    // Firestore directly rather than through the app.
    //
    // Costs one document read per write. At a dozen phones for a weekend
    // that is nothing.
    function isMember() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/bc_accounts/$(request.auth.uid));
    }

    // ── Directors ─────────────────────────────────────────────────
    // A flag on the membership document, and one that NO CLIENT CAN SET:
    // `create` below rejects any attempt to include it, and `update` is
    // denied outright, so the only way it gets there is a human editing
    // the document in the Firebase console (the admin SDK bypasses these
    // rules). That is the point — director is the one role that should not
    // be grantable from a phone, by a stray tap or by anybody who works
    // out what the app is talking to.
    //
    // It deliberately does NOT read the crown on the roster
    // (bc_players.isDirector). Rules cannot search for the roster row whose
    // auth_uid is yours — `get()` needs a path it can construct, and the
    // uid lives in a field — so that crown stays a label on screen and
    // this flag is what actually grants anything.
    //
    // `get(key, default)` rather than `.is_director`, so a membership
    // document written before this existed reads as false instead of
    // erroring the whole evaluation.
    function isDirector() {
      return isMember()
        && get(/databases/$(database)/documents/bc_accounts/$(request.auth.uid))
             .data.get('is_director', false) == true;
    }

    // The password, and the deliberate hole in it. `accessCode()` reads a
    // document no client may read — rules `get()` is not subject to read
    // rules, which is the whole trick: the secret can be compared without
    // ever being served.
    //
    // A missing or blank code means the door is open. That is not an
    // oversight, it is the bootstrap: before anybody has set a password
    // there is no way to present the right one, and without this the very
    // first membership could never be created and the project would be
    // bricked to its own owners.
    function accessCode() {
      return exists(/databases/$(database)/documents/bc_secrets/access)
        ? get(/databases/$(database)/documents/bc_secrets/access).data.code
        : null;
    }

    // Compared without case, because this password's life is being said
    // out loud across a table and typed into a phone by somebody who did
    // not see it written down. A capital letter at the front — from the
    // keyboard, or from whoever repeated it — was never a meaningful part
    // of the secret, and it cost an afternoon once.
    //
    // The `is string` guard is load-bearing: `.lower()` on a missing or
    // non-string field raises, and while a raised rule denies the write
    // just the same, denying it deliberately is easier to reason about
    // than denying it by accident. The stored code keeps whatever casing
    // the director typed — only the comparison is flattened, so Admin can
    // still show it back the way it was written.
    function codeOK() {
      return accessCode() == null
        || accessCode() == ''
        || (request.resource.data.get('code', null) is string
            && request.resource.data.code.lower() == accessCode().lower());
    }

    // ── The door ──────────────────────────────────────────────────
    // One document per account, id = uid, created by the account itself at
    // the password screen. Its existence IS membership; everything below
    // is gated on it.
    //
    // create: your own uid only, and only with the right password, and
    //         never carrying is_director. There is no other way to mint a
    //         membership — not even for a director.
    // read:   your own, plus every membership for a director, who needs to
    //         see who else is one to show it in Admin → Players.
    // update: ONE field, is_director, and only a director may set it, and
    //         never on themselves. See below.
    // delete: nobody. Revoking somebody entirely is deleting their
    //         document in the Firebase console, deliberately — a client
    //         that could delete its own membership could delete somebody
    //         else's if this rule were ever loosened by accident.
    //
    // Why a director may appoint another one, having just said the flag is
    // console-only: because the alternative was worse. Left console-only,
    // the crown in Admin → Players had to be a label that granted nothing,
    // and a director changing it next year would believe they had handed
    // over access when they had not. Two sources of truth, drifting
    // silently, a year apart. Now there is one, the app writes it, and the
    // crown shows what the rules will actually honour.
    //
    // It concedes little. A director can already rewrite the roster, the
    // rounds and the password; appointing someone is not a larger power
    // than that. What stays impossible is the dangerous half: nobody can
    // make THEMSELVES a director, at create time or after, so the flag
    // cannot be self-issued by anyone who merely knows the password.
    //
    // The self exclusion also holds an invariant worth having: a director
    // cannot demote themselves, so whoever is acting stays one, and the
    // set can never be emptied from inside the app. Stepping down entirely
    // is a console edit — the same place the FIRST director has to come
    // from, since this rule requires one to already exist.
    match /bc_accounts/{uid} {
      allow read: if isDirector() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn() && request.auth.uid == uid && codeOK()
                    && !('is_director' in request.resource.data);
      allow update: if isDirector()
                    && request.auth.uid != uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['is_director']);
      allow delete: if false;
    }

    // The password itself. Read is denied to everyone OUTSIDE the door and
    // that is the load-bearing half: if a stranger could read this document
    // they could read the code and let themselves in, and the gate would be
    // worth nothing. `codeOK()` above compares against it regardless, since
    // rules `get()` is not subject to these read rules.
    //
    // Directors can read it, so Admin can show one a code they have
    // forgotten, and change it. Nobody else can do either.
    match /bc_secrets/{doc} {
      allow read: if isDirector();
      allow write: if isDirector();
    }

    // ── Tournament data ───────────────────────────────────────────
    // Written by the director through the Admin tabs, read by everyone.
    // Every one of these corresponds to a screen only a director can open;
    // the call sites were walked before gating them (src/App.jsx —
    // onAddPlayer, onSetRound, onSetMatch, onAddCourse, onSaveGroups, the
    // Admin save handlers, and lib/editions.js).

    // The roster carries one exception, and it is the reason this block is
    // not a one-liner: claiming a name is an ordinary member writing to a
    // director-owned collection. It is allowed, narrowly — only the
    // auth_* fields may change, only to the claimer's own uid, and only on
    // a row nobody has claimed. So it cannot rename anybody, move a
    // handicap, hand out a crown, or take a name that is already taken.
    // The director's unlink is a plain director write and needs none of it.
    match /bc_players/{doc} {
      allow read: if isOpen();
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['auth_uid', 'auth_email', 'auth_provider', 'auth_linked_at'])
        && request.resource.data.auth_uid == request.auth.uid
        && (!('auth_uid' in resource.data)
            || resource.data.auth_uid == null
            || resource.data.auth_uid == request.auth.uid);
      allow write: if isDirector();
    }
    match /bc_courses/{doc}            { allow read: if isOpen();
                                         allow write: if isDirector(); }
    match /bc_rounds/{doc}             { allow read: if isOpen();
                                         allow write: if isDirector(); }
    match /bc_matches/{doc}            { allow read: if isOpen();
                                         allow write: if isDirector(); }
    // Playing groups — who tees off together, one document per round.
    // Group i goes off at slot i of that round's `tee_time` list; see
    // src/lib/groups.js.
    match /bc_groups/{doc}             { allow read: if isOpen();
                                         allow write: if isDirector(); }
    match /bc_tee_assignments/{doc}    { allow read: if isOpen();
                                         allow write: if isDirector(); }
    match /bc_hcp_overrides/{doc}      { allow read: if isOpen();
                                         allow write: if isDirector(); }
    // Frozen per-round handicaps. Written by the auto-lock on the first
    // score of a round as well as by the director; see src/lib/roundLocks.js.
    match /bc_round_locks/{doc}        { allow read: if isOpen();
                                         allow write: if isMember(); }
    match /bc_settings/{doc}           { allow read: if isOpen();
                                         allow write: if isDirector(); }
    match /bc_tournament_settings/{doc} { allow read: if isOpen();
                                         allow write: if isDirector(); }
    match /bc_editions/{doc}           { allow read: if isOpen();
                                         allow write: if isDirector(); }

    // ── The archive ───────────────────────────────────────────────
    // Past tournaments, one document per year. APPEND-ONLY: a signed-in
    // account may add a year, nobody may change or remove one.
    //
    // The app only ever subscribes to this collection (App.jsx, the
    // bc_historical listener) and has no code path that writes it, so the
    // restriction costs the running app nothing. The collection is also
    // empty today — the ten years of results live in the repo, under
    // data/historical sheets, and have never been loaded into Firestore.
    // That is exactly why `create` stays open: the next thing anyone does
    // here is that import, and a blanket write:false would have rejected
    // it. What append-only buys is that once a year IS archived, a
    // world-writable client cannot quietly rewrite or delete it.
    //
    // To correct a year already loaded, allow update for the one run:
    //   allow update: if isSignedIn();
    match /bc_historical/{doc}         { allow read: if isOpen();
                                         allow create: if isMember();
                                         allow update, delete: if false; }

    // ── Live scoring ──────────────────────────────────────────────
    // Written by players from the Scoring tab, so these can never be
    // director-only even once sign-in exists.
    match /bc_hole_scores/{doc}        { allow read: if isOpen();
                                         allow write: if isMember(); }
    match /bc_skins/{doc}              { allow read: if isOpen();
                                         allow write: if isMember(); }
    match /bc_ctp/{doc}                { allow read: if isOpen();
                                         allow write: if isMember(); }
    // Card signatures and attestations — one document per signed card. See
    // src/lib/cardSigs. Written by players from the Scoring tab (sign,
    // attest, unsign) and by the director's force-attest, so it belongs in
    // this half of the list rather than with the director-owned data.
    match /bc_card_sigs/{doc}          { allow read: if isOpen();
                                         allow write: if isMember(); }

    // ── Push notification tokens ──────────────────────────────────
    // (Read stays open here for the same reason as everywhere else; see
    // the note below on why this is the collection to tighten first.)
    // One document per (player, device). Holds an FCM registration token,
    // which is a send-to address, not a credential: possession lets you
    // push a notification to that device, not read anything from it. The
    // Cloud Functions in functions/ read this collection through the admin
    // SDK, which bypasses these rules entirely — the grant below is only
    // for the client that registers and revokes its own token.
    //
    // Worth noting what open READ means here specifically: unlike the rest
    // of this file, where the data is already public to anyone with the
    // bundle, this collection lets a reader enumerate the league's devices.
    // That is the same trade the app makes everywhere else, but it is the
    // one collection where a future sign-in should tighten reads first.
    match /bc_notification_tokens/{doc} { allow read: if isOpen();
                                         allow write: if isMember(); }

    // ── Everything else ───────────────────────────────────────────
    // Default deny. Adding a collection to the app means adding it here.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
