rules_version = '2';

// ══════════════════════════════════════════════════════════════════
//  Firestore security rules — The Bourbon Cup
// ══════════════════════════════════════════════════════════════════
//
// ── Read this before changing anything ────────────────────────────
// This app does NOT use Firebase Authentication. Nobody signs in; the
// login screen picks a player out of the roster and the director "code"
// (constants.DIRECTOR_CODE) is a client-side convenience that unhides the
// admin tab. Every request that reaches Firestore is therefore anonymous —
// `request.auth` is always null — so any rule that asks for an identity
// would lock the whole app out, not just the people it was meant to stop.
//
// What that means in practice: these rules are NOT an access-control
// boundary. Anyone who has the app's public Firebase config (it ships in
// the bundle, as it is designed to) can read and write this tournament's
// data. That is the trade the app has always made — a dozen friends, one
// weekend, no accounts. Do not mistake the list below for protection.
//
// What the list DOES do is bound the blast radius: only the collections
// this app actually uses are writable, so a stray or malicious client
// cannot create arbitrary collections in the project. Everything else is
// denied by default.
//
// ── If you ever add sign-in ───────────────────────────────────────
// Replace `isOpen()` with a real predicate (`request.auth != null` for
// reads, plus a directors document lookup for the admin-owned
// collections) and split the list into read-mostly and director-only
// halves. The collection list is already grouped that way below.
//
// ── What this replaces ────────────────────────────────────────────
// Until this file, the deployed rules were a single blanket grant:
//
//   match /{document=**} { allow read, write: if true; }
//
// So the enumeration below IS the change. It cannot break the running app:
// the list was taken from the collections the client actually touches
// (`db.subscribe` / `db.get` / `db.upsert` / `db.delete` in
// src/firebase.js, which is the only Firestore entry point in the repo —
// pipeline/ and api/ never reach Firestore), so anything newly denied is
// by construction something no code path here reads or writes. Data in
// such a collection is untouched, just unreachable until a line is added.
//
// Deploy with:  firebase deploy --only firestore:rules
//
// To exercise them without touching production, point a script at the
// emulator and check that each collection below accepts a write and that
// an unlisted one does not:
//   npx firebase emulators:exec --only firestore "node your-probe.mjs"

service cloud.firestore {
  match /databases/{database}/documents {

    // No identity exists to check (see above). Named rather than inlined so
    // that the day sign-in lands, there is exactly one place to change.
    function isOpen() {
      return true;
    }

    // ── Tournament data ───────────────────────────────────────────
    // Written by the director through the Admin tabs, read by everyone.
    match /bc_players/{doc}            { allow read, write: if isOpen(); }
    match /bc_courses/{doc}            { allow read, write: if isOpen(); }
    match /bc_rounds/{doc}             { allow read, write: if isOpen(); }
    match /bc_matches/{doc}            { allow read, write: if isOpen(); }
    // Playing groups — who tees off together, one document per round.
    // Group i goes off at slot i of that round's `tee_time` list; see
    // src/lib/groups.js.
    match /bc_groups/{doc}             { allow read, write: if isOpen(); }
    match /bc_tee_assignments/{doc}    { allow read, write: if isOpen(); }
    match /bc_hcp_overrides/{doc}      { allow read, write: if isOpen(); }
    // Frozen per-round handicaps. Written by the auto-lock on the first
    // score of a round as well as by the director; see src/lib/roundLocks.js.
    match /bc_round_locks/{doc}        { allow read, write: if isOpen(); }
    match /bc_settings/{doc}           { allow read, write: if isOpen(); }
    match /bc_tournament_settings/{doc} { allow read, write: if isOpen(); }
    match /bc_editions/{doc}           { allow read, write: if isOpen(); }

    // ── The archive ───────────────────────────────────────────────
    // Past tournaments, one document per year. APPEND-ONLY: anyone may add
    // a year, nobody may change or remove one.
    //
    // The app only ever subscribes to this collection (App.jsx, the
    // bc_historical listener) and has no code path that writes it, so the
    // restriction costs the running app nothing. The collection is also
    // empty today — the ten years of results live in the repo, under
    // data/historical sheets, and have never been loaded into Firestore.
    // That is exactly why `create` stays open: the next thing anyone does
    // here is that import, and a blanket write:false would have rejected
    // it. What append-only buys is that once a year IS archived, a
    // world-writable client cannot quietly rewrite or delete it.
    //
    // To correct a year already loaded, allow update for the one run:
    //   allow update: if isOpen();
    match /bc_historical/{doc}         { allow read, create: if isOpen();
                                         allow update, delete: if false; }

    // ── Live scoring ──────────────────────────────────────────────
    // Written by players from the Scoring tab, so these can never be
    // director-only even once sign-in exists.
    match /bc_hole_scores/{doc}        { allow read, write: if isOpen(); }
    match /bc_skins/{doc}              { allow read, write: if isOpen(); }
    match /bc_ctp/{doc}                { allow read, write: if isOpen(); }
    // Card signatures and attestations — one document per signed card. See
    // src/lib/cardSigs. Written by players from the Scoring tab (sign,
    // attest, unsign) and by the director's force-attest, so it belongs in
    // this half of the list rather than with the director-owned data.
    match /bc_card_sigs/{doc}          { allow read, write: if isOpen(); }

    // ── Push notification tokens ──────────────────────────────────
    // One document per (player, device). Holds an FCM registration token,
    // which is a send-to address, not a credential: possession lets you
    // push a notification to that device, not read anything from it. The
    // Cloud Functions in functions/ read this collection through the admin
    // SDK, which bypasses these rules entirely — the grant below is only
    // for the client that registers and revokes its own token.
    //
    // Worth noting what open READ means here specifically: unlike the rest
    // of this file, where the data is already public to anyone with the
    // bundle, this collection lets a reader enumerate the league's devices.
    // That is the same trade the app makes everywhere else, but it is the
    // one collection where a future sign-in should tighten reads first.
    match /bc_notification_tokens/{doc} { allow read, write: if isOpen(); }

    // ── Everything else ───────────────────────────────────────────
    // Default deny. Adding a collection to the app means adding it here.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
